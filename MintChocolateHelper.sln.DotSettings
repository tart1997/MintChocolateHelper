[Celeste.Mod.Entities.CustomEvent("$PARENT$/$CLASS$")]
public class $CLASS$ : Celeste.CutsceneEntity
{
    private readonly EventTrigger Trigger;
    private readonly Player Player;
    private readonly string EventId;
    
    public $CLASS$(EventTrigger trigger, Player player, string eventId) : base(fadeInOnSkip: true, endingChapterAfter: false)
    {
        Trigger = trigger;
        Player = player;
        EventId = eventId;
    }
    
    public override void OnBegin(Level level)
    {
        Player.StateMachine.State = Player.StDummy;
        Player.StateMachine.Locked = true;
        
        Add(new Coroutine(Cutscene(level)));
    }

    private IEnumerator Cutscene(Level level)
    {
        yield return null;
        $END$
        
        // sometimes EndCutscene isn't happy about being called, adding a second call usually works though
        EndCutscene(level);
        EndCutscene(level);
    }

    public override void OnEnd(Level level)
    {
        Player.StateMachine.State = Player.StNormal;
        Player.StateMachine.Locked = false;

        if (WasSkipped)
        {
            
        }
    }
}</s:String>
