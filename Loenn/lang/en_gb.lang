triggers.MintChocolateHelper/PulseFlagTrigger.placements.description.pulse_flag_trigger=Sets a flag ON/OFF for a specified amount of frames

triggers.MintChocolateHelper/PulseFlagTrigger.attributes.description.flag=The Flag to Pulse
